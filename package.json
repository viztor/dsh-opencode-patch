{
  "name": "dsh-opencode-patch",
  "version": "1.4.1",
  "description": "OpenCode on DeepSeek Harness — session affinity, Zen/Go gateway origin headers, free-tier tool fallback, and live Go quota display.",
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "missing-session-id",
    "opencode",
    "opencode-go",
    "opencode-zen",
    "prompt-cache",
    "session-affinity",
    "x-opencode-session"
  ],
  "homepage": "https://github.com/viztor/dsh-opencode-patch",
  "bugs": {
    "url": "https://github.com/viztor/dsh-opencode-patch/issues"
  },
  "license": "MIT",
  "author": {
    "name": "viztor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztor/dsh-opencode-patch.git"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && node --experimental-strip-types scripts/name-client-bundle.ts",
    "catalog:shim": "node --experimental-strip-types scripts/regenerate-catalog-shim.ts",
    "catalog:verify": "node --experimental-strip-types scripts/verify-catalog.ts",
    "catalog:verify:probe": "node --experimental-strip-types scripts/verify-catalog.ts --probe",
    "limits:shim": "node --experimental-strip-types scripts/generate-go-limits.ts",
    "check": "vp check",
    "clean": "rm -rf lib",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepare": "vp run build",
    "prepublishOnly": "vp run release:gate",
    "release:gate": "vp run build && vp run check && vp run test && node --experimental-strip-types scripts/check.ts",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "vp test --config vitest.e2e.config.ts",
    "test:mock": "vp test --config vitest.mock.config.ts",
    "typecheck": "tsc --noEmit",
    "cli:version": "node --experimental-strip-types scripts/check-vendor-version.ts",
    "version:patch": "vp pm version patch --no-git-checks",
    "version:minor": "vp pm version minor --no-git-checks",
    "version:major": "vp pm version major --no-git-checks"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
    "@earendil-works/pi-ai": "1.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vite-plus": "^1.3.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.2 <4.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.1 <0.2.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
